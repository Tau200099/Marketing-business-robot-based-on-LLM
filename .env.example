# ============================================================
# 复制成 .env 填好（服务器上放 /opt/feishu-bot/data/.env）。
# .env 不进 git、不进备份；改完要 systemctl restart feishu-bot
# ============================================================

# ---- 企业微信（config.yaml 的 global.platform: wecom）----
# 智能机器人长连接凭证【必填】：企微后台 -> 智能机器人 -> BotID / Secret。
# 收消息（只收 @机器人 的群消息和单聊）、发文字 / 图 / 文件、下载都靠它
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 定点通报 / 打卡通报 / 定时表情包发到的群，逗号分隔。回复跟着消息走，不看这个
WECOM_CHAT_IDS=
# 旧的 MCP 发文字通道，留空就全走长连接（推荐留空）
WECOM_MCP_URL=
# 长连接断开多少秒没连上就自动重启进程（看门狗），默认 180
# WECOM_WATCHDOG_SECONDS=180

# ---- 文字模型（判报单、问答助手、晒单容错；config.yaml 的 agent 段）----
# DeepSeek：https://platform.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 视觉模型（打卡照判定；config.yaml 的 checkin 段）----
# 阿里云百炼（通义千问 VL）。额度用完会自动换备用模型并单聊提醒管理员
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 运行 ----
# OCR 并发：每个并发峰值多 200~300MB 内存，小内存机器设 1
OCR_WORKERS=1
# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ---- 飞书（旧，platform: feishu 时才用，已不维护）----
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# FEISHU_CHAT_IDS=
