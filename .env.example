# ============================================================
# 平台凭证。用哪个平台在 config.yaml 的 global.platform 里选，
# 这里可以两套都填着，不冲突。
# ============================================================

# ---- 飞书（platform: feishu）----
# 开放平台 -> 你的自建应用 -> 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 定时通报 / 定点表情包要发到的群，逗号分隔。点赞跟着消息走，不看这个。
# 群 ID 用 python diagnose.py 列出来（形如 oc_xxxxxxxx）
FEISHU_CHAT_IDS=

# ---- 企业微信（platform: wecom）----
# 智能机器人长连接凭证【必填】：企微后台 -> 智能机器人 -> BotID / Secret。
# 收消息（只收 @机器人 的）、发图、发文件、下载都靠它
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# MCP 服务器地址（含 apikey），只用来发 markdown 文字；留空就全走长连接
WECOM_MCP_URL=
# 定时通报 / 定点表情包要发到的群，逗号分隔。点赞跟着消息走，不看这个
WECOM_CHAT_IDS=

# ---- 模型 API（config.yaml 里 agent.enabled: true 时必填）----
# 键名要和 config.yaml 里的 api_key_env 对上。
# DeepSeek 在 https://platform.deepseek.com 注册充值后拿 key
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 日志级别: DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
